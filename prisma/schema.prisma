// Wardrobe Vault — Prisma schema (Phase 1.1)
// Auth.js models are extended with domain fields; see docs/plan.md §1.1.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REVOKED
}

enum ListingStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  SOLD
  SUSPENDED
  ARCHIVED
}

enum ListingCondition {
  NEW_WITH_TAGS
  EXCELLENT
  VERY_GOOD
  GOOD
  FAIR
  WELL_LOVED
}

enum ListingDocumentType {
  PROOF_OF_PURCHASE
  DESIGNER_DOCUMENTATION
  CERTIFICATE
  EVENT_PHOTOGRAPH
  OWNERSHIP_DOCUMENTATION
  OTHER
}

enum OrderStatus {
  ORDER_PLACED
  PAYMENT_CONFIRMED
  AWAITING_SELLER
  SHIPPED
  IN_TRANSIT
  DELIVERED
  COMPLETED
  DISPUTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  CONFIRMED
  FAILED
  REFUNDED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  FAILED
  ON_HOLD
}

enum CommissionSettingType {
  DEFAULT
  SELLER
  CATEGORY
  PROMOTIONAL
}

enum WalletTransactionType {
  SALE_CREDIT
  COMMISSION_DEBIT
  PAYOUT_DEBIT
  ADJUSTMENT
  REFUND
}

enum ReportReason {
  SUSPECTED_COUNTERFEIT
  FALSE_CELEBRITY_CLAIM
  MISLEADING_DESCRIPTION
  INAPPROPRIATE_CONTENT
  FRAUD_CONCERN
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum NotificationType {
  LISTING_APPROVED
  LISTING_REJECTED
  LISTING_NEEDS_CHANGES
  ITEM_SOLD
  PURCHASE_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  PAYOUT_APPROVED
  PAYOUT_COMPLETED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  MESSAGE_RECEIVED
  OTHER
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) — extended User
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?

  role                   Role               @default(USER)
  isVerifiedPublicFigure Boolean            @default(false)
  verificationStatus     VerificationStatus @default(UNVERIFIED)
  suspendedAt            DateTime?
  suspendedReason        String?

  accounts Account[]
  sessions Session[]

  profile Profile?

  listings              Listing[]                  @relation("SellerListings")
  wornByListings        Listing[]                  @relation("WornByListings")
  favorites             Favorite[]
  ordersAsBuyer         Order[]                    @relation("BuyerOrders")
  ordersAsSeller        Order[]                    @relation("SellerOrders")
  wallet                Wallet?
  payouts               Payout[]
  payments              Payment[]
  notifications         Notification[]
  sentMessages          Message[]                  @relation("SentMessages")
  receivedMessages      Message[]                  @relation("ReceivedMessages")
  reportsFiled          Report[]                   @relation("ReportsFiled")
  reportsResolved       Report[]                   @relation("ReportsResolved")
  verificationRequests  PublicFigureVerification[] @relation("VerificationApplicant")
  verificationReviews   PublicFigureVerification[] @relation("VerificationReviewer")
  listingStatusChanges  ListingStatusHistory[]     @relation("ListingStatusActor")
  adminActions          AdminAction[]              @relation("AdminActions")
  sellerCommissionRates CommissionSetting[]        @relation("SellerCommissionRates")
  platformSettingUpdates PlatformSetting[]         @relation("PlatformSettingUpdates")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([verificationStatus])
  @@index([isVerifiedPublicFigure])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Profiles & verification
// ---------------------------------------------------------------------------

model Profile {
  id     String @id @default(cuid())
  userId String @unique

  bio              String? @db.Text
  location         String?
  region           String?
  photoUrl         String?
  headline         String?
  publicFigureBio  String? @db.Text
  websiteUrl       String?
  instagramHandle  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PublicFigureVerification {
  id     String @id @default(cuid())
  userId String

  status VerificationStatus @default(PENDING)

  applicationNotes String? @db.Text
  evidenceSummary  String? @db.Text
  evidenceUrls     String[] @default([])

  adminDecision String?
  adminNotes    String?  @db.Text
  reviewedById  String?
  reviewedAt    DateTime?
  submittedAt   DateTime  @default(now())

  user     User  @relation("VerificationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  listings           Listing[]
  commissionSettings CommissionSetting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Listing {
  id         String @id @default(cuid())
  sellerId   String
  categoryId String

  title    String
  brand    String?
  designer String?
  price    Int
  currency String  @default("UGX")

  size      String?
  color     String?
  material  String?
  condition ListingCondition?

  wornByName     String?
  wornByUserId   String?
  wornBySeller   Boolean   @default(false)
  wornWhere      String?
  eventName      String?
  eventDate      DateTime?
  timesWorn      Int?
  storyDetails   String?   @db.Text
  storyVerifiedByVault Boolean @default(false)

  authenticityNotes            String? @db.Text
  authenticityVerifiedByVault  Boolean @default(false)

  status          ListingStatus @default(DRAFT)
  rejectionReason String?       @db.Text
  adminNotes      String?       @db.Text

  publishedAt DateTime?
  soldAt      DateTime?
  submittedAt DateTime?

  seller   User     @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])
  wornBy   User?    @relation("WornByListings", fields: [wornByUserId], references: [id], onDelete: SetNull)

  images         ListingImage[]
  documents      ListingDocument[]
  statusHistory  ListingStatusHistory[]
  shippingDetail ShippingDetail?
  favorites      Favorite[]
  orderItems     OrderItem[]
  reports        Report[]
  messages       Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brand])
  @@index([designer])
  @@index([price])
  @@index([status])
  @@index([sellerId])
  @@index([publishedAt])
  @@index([eventName])
}

model ListingImage {
  id        String @id @default(cuid())
  listingId String

  cloudinaryPublicId String
  url                String
  sortOrder          Int     @default(0)
  altText            String?
  width              Int?
  height             Int?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([listingId])
}

model ListingDocument {
  id        String @id @default(cuid())
  listingId String

  type               ListingDocumentType
  cloudinaryPublicId String
  url                String
  fileName           String?
  mimeType           String?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([listingId])
}

model ListingStatusHistory {
  id        String @id @default(cuid())
  listingId String

  fromStatus ListingStatus?
  toStatus   ListingStatus
  actorId    String?
  reason     String?        @db.Text
  notes      String?        @db.Text

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  actor   User?   @relation("ListingStatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([createdAt])
}

model ShippingDetail {
  id        String @id @default(cuid())
  listingId String @unique

  isAvailable       Boolean @default(true)
  regions           String[] @default([])
  fee               Int      @default(0)
  estimatedDaysMin  Int?
  estimatedDaysMax  Int?
  notes             String?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Favorite {
  id        String @id @default(cuid())
  userId    String
  listingId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

// ---------------------------------------------------------------------------
// Orders & payments
// ---------------------------------------------------------------------------

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  buyerId  String
  sellerId String

  status        OrderStatus   @default(ORDER_PLACED)
  paymentStatus PaymentStatus @default(PENDING)
  payoutStatus  PayoutStatus  @default(PENDING)

  itemPrice        Int
  commissionAmount Int
  commissionRateBps Int
  shippingFee      Int
  totalAmount      Int
  currency         String @default("UGX")

  trackingNumber String?
  trackingCarrier String?
  trackingUrl    String?

  placedAt    DateTime  @default(now())
  paidAt      DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  buyer  User @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller User @relation("SellerOrders", fields: [sellerId], references: [id])

  items    OrderItem[]
  payments Payment[]
  payout   Payout?
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([payoutStatus])
  @@index([placedAt])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  listingId String

  titleSnapshot String
  price         Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id])

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([listingId])
}

model Payment {
  id      String @id @default(cuid())
  orderId String
  userId  String

  provider          String        @default("mock")
  providerReference String?
  status            PaymentStatus @default(PENDING)
  amount            Int
  currency          String        @default("UGX")
  failureReason     String?
  metadata          Json?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([providerReference])
}

model Payout {
  id       String @id @default(cuid())
  orderId  String @unique
  sellerId String

  grossAmount      Int
  commissionAmount Int
  netAmount        Int
  currency         String       @default("UGX")
  status           PayoutStatus @default(PENDING)

  approvedById String?
  approvedAt   DateTime?
  paidAt       DateTime?
  failureReason String?
  notes         String?

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller   User  @relation(fields: [sellerId], references: [id])
  walletTransactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Wallet & commission
// ---------------------------------------------------------------------------

model Wallet {
  id     String @id @default(cuid())
  userId String @unique

  availableBalance Int @default(0)
  pendingBalance   Int @default(0)

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id       String @id @default(cuid())
  walletId String

  type        WalletTransactionType
  amount      Int
  currency    String  @default("UGX")
  description String?
  payoutId    String?

  wallet Wallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  payout Payout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([createdAt])
}

model CommissionSetting {
  id String @id @default(cuid())

  type         CommissionSettingType
  name         String
  rateBps      Int
  isActive     Boolean @default(true)
  sellerId     String?
  categoryId   String?
  validFrom    DateTime?
  validUntil   DateTime?
  description  String?

  seller   User?     @relation("SellerCommissionRates", fields: [sellerId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isActive])
  @@index([sellerId])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Messaging, notifications, moderation, audit
// ---------------------------------------------------------------------------

model Notification {
  id     String @id @default(cuid())
  userId String

  type    NotificationType
  title   String
  body    String           @db.Text
  link    String?
  metadata Json?
  readAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

model Message {
  id        String  @id @default(cuid())
  threadId  String
  senderId  String
  recipientId String

  orderId   String?
  listingId String?
  body      String  @db.Text
  readAt    DateTime?

  sender    User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User     @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
  @@index([senderId])
  @@index([recipientId])
  @@index([orderId])
}

model Report {
  id         String @id @default(cuid())
  reporterId String
  listingId  String

  reason  ReportReason
  details String?      @db.Text
  status  ReportStatus @default(OPEN)

  resolvedById String?
  resolvedAt   DateTime?
  resolutionNotes String? @db.Text

  reporter User    @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  resolver User?   @relation("ReportsResolved", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId])
  @@index([status])
}

model AdminAction {
  id      String @id @default(cuid())
  adminId String

  action     String
  targetType String
  targetId   String
  details    Json?

  admin User @relation("AdminActions", fields: [adminId], references: [id])

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model PlatformSetting {
  key         String @id
  value       String @db.Text
  updatedById String?

  updatedBy User? @relation("PlatformSettingUpdates", fields: [updatedById], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt
}

/// DB-backed rate limiting for auth endpoints (tech-spec §Gaps.4).
model AuthRateLimit {
  key             String   @id
  attemptCount    Int      @default(1)
  windowExpiresAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([windowExpiresAt])
}
